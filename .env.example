# ShadowNote Docker Compose configuration
# Copy to .env and adjust before `docker compose up -d`

# Site public origin, used for the API's CORS_ORIGIN.
# Must match the address users type in the browser, e.g. https://notes.example.com
SHADOW_NOTE_ORIGIN=http://localhost:8080

# Host port for the web container
SHADOW_NOTE_PORT=8080

# Socket URL baked into the frontend at build time.
# Keep "/" for the default same-origin reverse-proxy mode.
# Set to the API's public URL (e.g. https://sync.example.com) only when
# serving the frontend and API from different domains.
SHADOW_NOTE_SOCKET_URL=/

# API log level: error | warn | info | debug
SHADOW_NOTE_LOG_LEVEL=info
